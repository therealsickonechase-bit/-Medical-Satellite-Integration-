                    node_id TEXT PRIMARY KEY,
                    node_type TEXT,
                    node_address TEXT,
                    node_status TEXT,
                    connection_time TEXT,
                    last_heartbeat TEXT,
                    network_protocol TEXT,
                    security_level TEXT,
