    def register_network(self, network_name: str, network_type: str,
                        chain_id: int, block_time: float = 15.0) -> BlockchainNetworkInfo:
        """Register a blockchain network"""
        network_id = self.generate_unique_id(f"NET_{network_name}")
        
        # Get network type details
        network_details = self.network_types.get(network_type, {
            "type": network_type,
            "protocol": "UNKNOWN",
            "chain_id": chain_id
        })
        
        network_info = BlockchainNetworkInfo(
            network_id=network_id,
            network_name=network_name,
            network_type=network_details["type"],
            network_protocol=network_details["protocol"],
            chain_id=chain_id,
            block_time=block_time,
            current_height=1000000 + (int(time.time()) % 100000),
            sync_status="synced",
            node_count=23 + (int(time.time()) % 10),
            security_level="high",
            network_metadata={
                "registered_at": datetime.now().isoformat(),
                "source": "RABBIT-BLOCKCHAIN-TRACKER",
                "nodes_count": 23 + (int(time.time()) % 10),
                "security_level": "high"
            }
        )
        
        # Store network
        with self.lock:
            self.networks[network_id] = network_info
            self._save_network_to_db(network_info)
            
        self.logger.info(f"Registered blockchain network: {network_name}")
