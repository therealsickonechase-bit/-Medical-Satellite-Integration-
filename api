    def generate_unique_id(self, prefix: str = "") -> str:
        """Generate unique ID with timestamp and hash"""
        timestamp = str(int(time.time()))
        hash_part = hashlib.md5(timestamp.encode()).hexdigest()[:12]
        if prefix:
            return f"{prefix}_{timestamp}_{hash_part}"
        return f"ID_{timestamp}_{hash_part}"
    
    def register_node(self, node_type: str, node_address: str, 
                     network_protocol: str = "ETH", 
                     security_level: str = "high") -> NodeInfo:
        """Register a new node in the blockchain network"""
        node_id = self.generate_unique_id(f"NODE_{node_type}")
        
        # Create node information
        node_info = NodeInfo(
            node_id=node_id,
            node_type=node_type,
            node_address=node_address,
            node_status="connected",
            connection_time=datetime.now().isoformat(),
            last_heartbeat=datetime.now().isoformat(),
            network_protocol=network_protocol,
            security_level=security_level,
            node_version="2.2.9-GOVERNMENT-SECURITY",
            node_metadata={
                "registered_at": datetime.now().isoformat(),
                "source": "RABBIT-BLOCKCHAIN-TRACKER",
                "security_level": security_level
            }
        )
        
        # Store node
        with self.lock:
            self.nodes[node_id] = node_info
            self._save_node_to_db(node_info)
            
        self.logger.info(f"Registered new node: {node_id} ({node_type})")
        return node_info
    
    def register_block(self, block_hash: str, block_number: int, 
                      network_name: str, miner_address: str = "UNKNOWN",
                      transaction_count: int = 0) -> BlockInfo:
        """Register a new block"""
        # Validate block hash
        if not block_hash.startswith("0x") or len(block_hash) != 66:
            block_hash = f"0x{hashlib.sha256(block_hash.encode()).hexdigest()}"
        
        block_info = BlockInfo(
            block_hash=block_hash,
            block_number=block_number,
            block_timestamp=datetime.now().isoformat(),
            previous_hash=self._get_last_block_hash(network_name),
            transaction_count=transaction_count,
            block_size=1024 * (block_number % 100) + 512,  # Simulated
            block_reward=float(block_number % 10) + 1.0,  # Simulated
            miner_address=miner_address,
            network_name=network_name,
            security_status="verified",
            verification_status="complete",
            block_metadata={
                "registration_timestamp": datetime.now().isoformat(),
                "source": "RABBIT-BLOCKCHAIN-TRACKER",
                "digitized": True
            }
        )
        
        # Store block
        with self.lock:
            self.blocks[block_hash] = block_info
            self._save_block_to_db(block_info)
            
        self.logger.info(f"Registered new block: {block_hash} (#{block_number})")
        return block_info
    
