            # Blocks database
            blocks_db = os.path.join(self.log_directory, 'blocks.db')
            conn = sqlite3.connect(blocks_db)
            cursor = conn.cursor()
            
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS blocks (
                    block_hash TEXT PRIMARY KEY,
